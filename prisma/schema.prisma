generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Product {
  id                      Int             @id @default(autoincrement())
  codigo                  String
  nombre                  String
  precio                  Decimal         @db.Decimal(10, 2)
  imagenUrl               String
  galeria                 String[]        @default([])
  descripcion1            String
  descripcion2            String
  categoryId              Int?
  category                Category?       @relation(fields: [categoryId], references: [id])
  stockActual             Int             @default(0)
  minStock                Int             @default(0)
  precioPromedioCompra    Decimal         @db.Decimal(18, 6) @default(0)
  fechaPromedioCompra     DateTime?       @db.Timestamp(6)
  valorInventarioActual   Decimal         @db.Decimal(18, 6) @default(0)
  costoInicialConfigurado Boolean         @default(false)
  esServicio              Boolean         @default(false)
  mostrarEnWeb            Boolean         @default(true)
  incomingOrders          IncomingOrder[]
  quotationItems          QuotationItem[]
  inventoryLogs           InventoryLog[]
  discounts               ProductDiscount[]
  createdAt               DateTime?       @default(now()) @db.Timestamp(6)
  updatedAt               DateTime?       @default(now()) @db.Timestamp(6)
}

model IncomingOrder {
  id            Int       @id @default(autoincrement())
  productId     Int
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  cantidad      Int       @default(0)
  costoUnitario Decimal   @default(0) @db.Decimal(10, 2)
  fechaPedido   DateTime  @default(now()) @db.Timestamp(6)
  fechaEstimada DateTime? @db.Timestamp(6)
  estado        String    @default("EN_CAMINO") // EN_CAMINO, COMPLETADO, CANCELADO
  tipo          String    @default("PEDIDO") // PEDIDO, AJUSTE_INGRESO, AJUSTE_SALIDA, INICIALIZACION
  motivo        String?
  createdAt     DateTime? @default(now()) @db.Timestamp(6)
  updatedAt     DateTime? @default(now()) @db.Timestamp(6)
}


/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Category {
  id           Int       @id @default(autoincrement())
  nombre       String    @unique
  mostrarEnWeb Boolean   @default(true)
  products     Product[]
  createdAt    DateTime? @default(now()) @db.Timestamp(6)
  updatedAt    DateTime? @default(now()) @db.Timestamp(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model User {
  id                 Int       @id @default(autoincrement())
  email              String    @unique
  password           String
  isSuperAdmin       Boolean?  @default(false)
  createdAt          DateTime? @default(now()) @db.Timestamp(6)
  updatedAt          DateTime? @default(now()) @db.Timestamp(6)
  resetToken         String?
  resetTokenExpiry   DateTime? @db.Timestamp(6)
}

model Client {
  id              Int                @id @default(autoincrement())
  nit             String?            @unique
  nombre          String
  email           String?
  telefono        String?
  contacto        String?
  direccion       String?
  ciudad          String?
  departamento    String?
  pais            String?            @default("Colombia")
  quotations      Quotation[]
  createdAt       DateTime?          @default(now()) @db.Timestamp(6)
  updatedAt       DateTime?          @default(now()) @db.Timestamp(6)
}

enum QuotationStatus {
  COTIZACION
  APROBADA
  RECHAZADA
  CUENTA_COBRO
  PAGADA
}

model Quotation {
  id                        Int             @id @default(autoincrement())
  numeroCotizacion          String          @unique
  numeroCuentaCobro         String?         @unique // Generado al facturar / pasar a CUENTA_COBRO
  estado                    QuotationStatus @default(COTIZACION)
  total                     Decimal         @db.Decimal(10, 2) @default(0)
  clientId                  Int
  client                    Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  items                     QuotationItem[]
  subtotalVenta             Decimal         @db.Decimal(10, 2) @default(0)
  subtotalCosto             Decimal         @db.Decimal(10, 2) @default(0)
  utilidadTotal             Decimal         @db.Decimal(10, 2) @default(0)
  rentabilidadPorcentual    Decimal         @db.Decimal(10, 2) @default(0)
  rentabilidadMensual       Decimal         @db.Decimal(10, 2) @default(0)
  rentabilidadEfectivaAnual Decimal         @db.Decimal(10, 2) @default(0)
  diasPromedioInventario    Decimal         @db.Decimal(10, 2) @default(0)
  fechaCotizacion           DateTime        @default(now()) @db.Timestamp(6)
  fechaCuentaCobro          DateTime?       @db.Timestamp(6)
  fechaVencimiento          DateTime?       @db.Timestamp(6)
  pagadoConRetenciones      Boolean         @default(false)
  montoPagado               Decimal?        @db.Decimal(10, 2)
  retenciones               Decimal?        @db.Decimal(10, 2)
  createdAt                 DateTime?       @default(now()) @db.Timestamp(6)
  updatedAt                 DateTime?       @default(now()) @db.Timestamp(6)
}

model QuotationItem {
  id                        Int       @id @default(autoincrement())
  quotationId               Int
  quotation                 Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId                 Int
  product                   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  cantidad                  Int       @default(1)
  precioUnitario            Decimal   @db.Decimal(10, 2)
  costoPromedioUnitario     Decimal   @db.Decimal(10, 2) @default(0)
  fechaPromedioCompra       DateTime? @db.Timestamp(6)
  utilidadUnitaria          Decimal   @db.Decimal(10, 2) @default(0)
  utilidadTotal             Decimal   @db.Decimal(10, 2) @default(0)
  diasInventario            Int       @default(0)
  rentabilidadPorcentual    Decimal   @db.Decimal(10, 2) @default(0)
  rentabilidadMensual       Decimal   @db.Decimal(10, 2) @default(0)
  rentabilidadEfectivaAnual Decimal   @db.Decimal(10, 2) @default(0)
  createdAt                 DateTime? @default(now()) @db.Timestamp(6)
  updatedAt                 DateTime? @default(now()) @db.Timestamp(6)
}

model SystemSettings {
  id                   Int     @id @default(1)
  startQuotationNumber Int     @default(1)
  startBillNumber      Int     @default(1)
  bankDetails          String  @default("Transferencias a:\nNequi: 316 831 4501\nBancolombia Ahorros: 123-456789-01")
  companyName          String  @default("CONSUMIBLES & REPUESTOS")
  companySlogan        String  @default("Equipos de Corte Plasma y Soldadura Industrial")
  companyPhone         String  @default("+57 316 831 4501")
  debeANombre          String? @default("")
  debeACedula          String? @default("")
}

model InventoryLog {
  id          Int      @id @default(autoincrement())
  productId   Int
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  tipo        String   // COMPRA, VENTA, INICIALIZACION, REVERSION
  cantidad    Int
  costoUnit   Decimal  @db.Decimal(18, 6)
  stockPrevio Int
  stockNuevo  Int
  detalle     String?
  createdAt   DateTime @default(now()) @db.Timestamp(6)
}

model Discount {
  id              Int               @id @default(autoincrement())
  nombre          String
  tipoDescuento   String            // Porcentaje / ValorFijo
  valorDescuento  Decimal           @db.Decimal(10, 2)
  fechaInicio     DateTime          @db.Timestamp(6)
  fechaFin        DateTime          @db.Timestamp(6)
  activo          Boolean           @default(true)
  fechaCreacion   DateTime          @default(now()) @db.Timestamp(6)
  usuarioCreacion String?
  products        ProductDiscount[]
}

model ProductDiscount {
  idProducto  Int
  product     Product  @relation(fields: [idProducto], references: [id], onDelete: Cascade)
  idDescuento Int
  discount    Discount @relation(fields: [idDescuento], references: [id], onDelete: Cascade)

  @@id([idProducto, idDescuento])
}

model AnalyticsExcludedIp {
  id              Int      @id @default(autoincrement())
  ipHash          String   @unique
  reason          String   @default("admin_login")
  firstDetectedAt DateTime @default(now()) @db.Timestamp(6)
  lastDetectedAt  DateTime @default(now()) @db.Timestamp(6)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamp(6)
  updatedAt       DateTime @default(now()) @db.Timestamp(6)
}

model AnalyticsVisitor {
  id          String             @id
  firstSeenAt DateTime           @default(now()) @db.Timestamp(6)
  lastSeenAt  DateTime           @default(now()) @db.Timestamp(6)
  deviceType  String?
  os          String?
  browser     String?
  screenWidth Int?
  screenHeight Int?
  language    String?
  country     String?
  countryCode String?
  region      String?
  city        String?
  isExcluded  Boolean            @default(false)
  sessions    AnalyticsSession[]
  createdAt   DateTime           @default(now()) @db.Timestamp(6)
  updatedAt   DateTime           @default(now()) @db.Timestamp(6)
}

model AnalyticsSession {
  id              String              @id
  visitorId       String
  visitor         AnalyticsVisitor    @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  startedAt       DateTime            @default(now()) @db.Timestamp(6)
  lastActiveAt    DateTime            @default(now()) @db.Timestamp(6)
  durationSeconds Int                 @default(0)
  ipHash          String?
  referrer        String?
  referrerHost    String?
  entryPage       String?
  exitPage        String?
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmTerm         String?
  utmContent      String?
  country         String?
  countryCode     String?
  region          String?
  city            String?
  isExcluded      Boolean             @default(false)
  excludedReason  String?
  excludedAt      DateTime?           @db.Timestamp(6)
  pageViews       AnalyticsPageView[]
  events          AnalyticsEvent[]

  @@index([ipHash])
  @@index([isExcluded])
}

model AnalyticsPageView {
  id         Int              @id @default(autoincrement())
  visitorId  String
  sessionId  String
  session    AnalyticsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  url        String
  pathname   String
  title      String?
  referrer   String?
  isExcluded Boolean          @default(false)
  createdAt  DateTime         @default(now()) @db.Timestamp(6)

  @@index([sessionId])
  @@index([isExcluded])
}

model AnalyticsEvent {
  id         Int              @id @default(autoincrement())
  visitorId  String
  sessionId  String
  session    AnalyticsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  eventName  String
  pathname   String?
  metadata   Json?
  isExcluded Boolean          @default(false)
  createdAt  DateTime         @default(now()) @db.Timestamp(6)

  @@index([sessionId])
  @@index([eventName])
  @@index([isExcluded])
}


